.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store

# NOTE: data/jobs.db is intentionally NOT ignored — it is committed to the repo
# so Streamlit Cloud can read it directly (see PLAN §5). Its WAL sidecars are
# transient and must never be: committing them alongside a checkpointed DB can
# corrupt what the next reader sees.
data/*.db-wal
data/*.db-shm
